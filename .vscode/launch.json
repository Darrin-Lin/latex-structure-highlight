{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run LaTeX Structure Highlight",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "npm: compile",
      "outFiles": ["${workspaceFolder}/out/src/**/*.js"],
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/examples/sample-en.tex"]
    }
  ]
}
